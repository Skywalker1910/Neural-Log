# Copy this file to `.env` and fill in real values for your machine/deployment.
# `.env` itself is gitignored - never commit real secrets.
#
# The app reads these once, at import. A production instance that is missing a
# required one refuses to start rather than starting wrong; see security.py.

# ---------------------------------------------------------------------------
# Which set of rules applies
# ---------------------------------------------------------------------------
# `development` (the default) or `production`. This one switch decides whether
# the secret key is required, whether cookies are marked Secure, and whether
# registration needs an invite code. CSRF, login rate limiting and the JSON
# error responses are on either way.
NEURAL_LOG_ENV=development

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Flask signs the session cookie with this. Anyone who knows it can mint a
# session for any account, so the published default is not a weak key - it is no
# key at all, and production will not boot without a real one.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-value

# ---------------------------------------------------------------------------
# Who can create an account
# ---------------------------------------------------------------------------
# `open`, `invite` or `closed`. Defaults to open in development and invite in
# production, so forgetting to set it leaves the door shut rather than open.
REGISTRATION_MODE=open

# The phrase a new friend has to type. Required when REGISTRATION_MODE=invite in
# production; change it if it ever gets forwarded somewhere it shouldn't.
REGISTRATION_CODE=

# Which account gets the admin bit, by name. Without it the rule is "whoever
# registers first", which is fine on a laptop and a land-grab on a fresh public
# database - the first stranger to find the sign-up form would own the app.
ADMIN_USERNAME=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Set to 1 for the Werkzeug debug/auto-reload server during local development.
# Must be unset (or 0) anywhere the app is reachable outside your own machine -
# the debugger allows arbitrary code execution if left on.
FLASK_DEBUG=1

# Path to the SQLite database file. On a deployed host point this at a path on
# persistent storage, not inside the application directory.
DATABASE=neural_log.db

# Port the dev server listens on (python app.py). Ignored when served via gunicorn.
PORT=5000
